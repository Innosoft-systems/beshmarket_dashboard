# Dashboard (Next.js) — nusxa oling: cp .env.example .env.local
#
# Barcha o'zgaruvchilar NEXT_PUBLIC_ prefiksi bilan, ya'ni ular brauzer
# bundle'iga tushadi. Maxfiy kalitlarni (service account, JWT secret va h.k.)
# bu yerga YOZMANG.

# ── Backend ───────────────────────────────────────────────────────────────────
# Backend origin — `/api/v1` kod tomonidan qo'shiladi, shuning uchun bu yerga
# qo'shmang. Socket.io ulanishi (`/orders` namespace) va rasm/audio yuklash
# (`/uploads/**`) uchun ham shu manzil ishlatiladi.
# Ishlatilgan joylar: lib/api/client.ts, middleware.ts, next.config.ts,
#                     hooks/use-restaurant-socket.ts, lib/order-sound.ts
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Yandex Maps ───────────────────────────────────────────────────────────────
# Yetkazib berish zonalari, kuryerlar xaritasi va smena slotlari uchun.
# Bo'sh qoldirilsa xarita komponentlari yuklanmaydi (ilova ishlashda davom etadi).
# Kalit: https://developer.tech.yandex.ru/ → JavaScript API
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# ── Firebase Cloud Messaging (push bildirishnomalar) ──────────────────────────
# Ixtiyoriy, lekin "hammasi yoki hech biri": beshtasidan bittasi bo'sh bo'lsa
# push butunlay o'chadi (hooks/use-fcm-token.ts va app/api/firebase-config
# to'liqlikni tekshiradi). Qiymatlar: Firebase Console → Project settings → General.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push sertifikati (Cloud Messaging → Web configuration → Key pair).
# Yuqoridagi 5 tasi to'liq bo'lsa ham, busiz FCM token olinmaydi.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
